FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
FOUNDRY_MODEL=gpt-5-mini

# OPTIONAL — only if you cannot use Azure AD auth.
# Leave this blank to authenticate with `az login` (preferred: nothing secret
# is stored). Set it only when a collaborator is outside the resource owner's
# Azure directory. Never commit a real value; .env is gitignored.
FOUNDRY_API_KEY=
FOUNDRY_EMBEDDING_MODEL=text-embedding-3-large

AZURE_SUBSCRIPTION_ID=<subscription-guid>
AZURE_RESOURCE_GROUP=<resource-group>
AZURE_FOUNDRY_ACCOUNT=<foundry-account-name>

AZURE_SEARCH_ENDPOINT=https://<search-service>.search.windows.net
AZURE_SEARCH_INDEX=scuba-baselines
AZURE_OPENAI_ENDPOINT=https://<foundry-account>.openai.azure.com/
