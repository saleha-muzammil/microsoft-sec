# Microsoft Foundry (Azure AI Foundry) — copy to .env and fill in. NEVER commit .env
AZURE_AI_PROJECT_ENDPOINT=https://<your-foundry-resource>.services.ai.azure.com/api/projects/<project-name>
AZURE_AI_MODEL_DEPLOYMENT_NAME=<your-chat-model-deployment>
AZURE_SUBSCRIPTION_ID=<subscription-guid>
AZURE_RESOURCE_GROUP=<resource-group>

# Optional: Azure AI Search (RAG over baselines)
AZURE_SEARCH_ENDPOINT=https://<your-search>.search.windows.net
AZURE_SEARCH_INDEX_NAME=scuba-baselines

# Auth: we use DefaultAzureCredential (run `az login`). No keys in this file.
